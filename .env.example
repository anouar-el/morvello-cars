GEMINI_API_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_STUDIO=
NODE_ENV=
# Push notifications (optional). Generate the pair with `npm run push:keys`, then run
# supabase_migration_push_subscriptions.sql once. Needs SUPABASE_SERVICE_ROLE_KEY above.
# VAPID_SUBJECT is a contact for the push services: "mailto:you@example.com" or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional. "true" makes the Content-Security-Policy log violations in the browser console
# instead of blocking them (use it to validate a new deployment, then remove it).
CSP_REPORT_ONLY=