{
  "entities": {
    "Agency": {
      "title": "Agency",
      "description": "Morvello rental agency central cloud record containing fleet, contracts, clients and settings",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 100
        },
        "updatedBy": {
          "type": "string",
          "description": "User or manager who updated the record",
          "maxLength": 128
        },
        "vehicles": {
          "type": "array",
          "description": "Fleet vehicles list"
        },
        "clients": {
          "type": "array",
          "description": "Registered clients list"
        },
        "drivers": {
          "type": "array",
          "description": "Registered drivers list"
        },
        "contracts": {
          "type": "array",
          "description": "Rental contracts list"
        },
        "deposits": {
          "type": "array",
          "description": "Security deposit records"
        },
        "companySettings": {
          "type": "object",
          "description": "Agency legal and general settings"
        },
        "termsVersion": {
          "type": "object",
          "description": "Active contractual terms clauses"
        },
        "users": {
          "type": "array",
          "description": "System users and managers"
        },
        "aiSettings": {
          "type": "object",
          "description": "AI assistant settings"
        },
        "auditLogs": {
          "type": "array",
          "description": "Security audit logs"
        }
      },
      "required": ["updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Individual authenticated user RBAC profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching document ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Verified user email address",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "RBAC user role (admin, manager, agent)",
          "enum": ["admin", "manager", "agent"]
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 50
        },
        "agency": {
          "type": "string",
          "description": "Assigned agency identifier or name",
          "maxLength": 200
        },
        "assignedFleetName": {
          "type": "string",
          "description": "Fleet scope assigned to this manager",
          "maxLength": 200
        },
        "adminClaim": {
          "type": "boolean",
          "description": "Flag indicating administrative privilege"
        },
        "permissions": {
          "type": "object",
          "description": "Granular user permissions object"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 100
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of administrator who updated the profile",
          "maxLength": 128
        }
      },
      "required": ["uid", "email", "role"]
    },
    "TestDoc": {
      "title": "TestDoc",
      "description": "Connection test probe document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Health status",
          "maxLength": 50
        }
      }
    }
  },
  "firestore": {
    "/agencies/{agencyId}": {
      "schema": "Agency",
      "description": "Central company agency document"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user RBAC record"
    },
    "/test/{docId}": {
      "schema": "TestDoc",
      "description": "Connection probe document"
    }
  }
}
