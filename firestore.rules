rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation document
    match /test/{docId} {
      allow read: if isValidId(docId);
    }

    // Individual user profile and role document (RBAC)
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Central agency cloud document
    // Accessible across all authorized Morvello agency workstations for multi-browser sync
    match /agencies/{agencyId} {
      allow read, write: if isValidId(agencyId);
    }
  }
}

