rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation document
    match /test/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // Individual user profile and role document (RBAC)
    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId);
    }

    // Central agency cloud document
    // Morvello Cars Rental Management Platform
    // Accessible by authenticated team members
    match /agencies/{agencyId} {
      allow read, write: if isSignedIn() && isValidId(agencyId);
    }
  }
}

