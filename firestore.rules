rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    // Distinguish real authenticated users (email/password or Google) from anonymous sessions
    function isNonAnonymous() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isNonAnonymous() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'anouar7fac@gmail.com' ||
        request.auth.token.email == 'anouar@morvellocars.com'
      );
    }

    // Connection validation document
    match /test/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // Individual user profile and role document (RBAC)
    // Read: authenticated non-anonymous team member
    // Write: strictly restricted to document owner (request.auth.uid == userId) or verified admin
    match /users/{userId} {
      allow read: if isNonAnonymous() && isValidId(userId);
      allow create, update: if isNonAnonymous() && (request.auth.uid == userId || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Central agency cloud document
    // Accessible only by verified, non-anonymous authenticated team members
    match /agencies/{agencyId} {
      allow read, write: if isNonAnonymous() && isValidId(agencyId);
    }
  }
}

